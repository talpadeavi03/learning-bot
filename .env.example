# AETHER OS — Environment Variables
# Copy to .env and fill in values

# ─── Cloudflare ───
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=

# ─── Supabase ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── GitHub (for activity tracking) ───
GITHUB_TOKEN=ghp_xxxxx
GITHUB_USERNAME=your-username

# ─── Worker Secrets (set via: wrangler secret put KEY_NAME) ───
# ENCRYPT_KEY      → AES-256 encryption key for neural memory
# ADMIN_KEY        → protects /reset-data, /update-dashboard, /jobs/clear

# ─── Gmail Reader (optional, for job-bot) ───
# Place credentials.json from Google Cloud Console in job-bot/ directory
# First run will generate token.json via OAuth flow
